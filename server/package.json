{
  "name": "@troko/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server/src/index.js",
  "scripts": {
    "dev": "PORT=${PORT:-3001} node --watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.json && node -e \"import('node:fs').then(fs => fs.writeFileSync('dist/index.js', \\\"import './server/src/index.js';\\\\n\\\"))\"",
    "start": "node dist/server/src/index.js",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.19.2"
  }
}
